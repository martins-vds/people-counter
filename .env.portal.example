# Required: an existing ADLS Gen2 account and filesystem. No local footage mount.
PC_PORTAL_ADLS_ACCOUNT_URL=https://youraccount.dfs.core.windows.net
PC_PORTAL_ADLS_FILESYSTEM=videos
PC_PORTAL_ADLS_ROOT=
PC_PORTAL_MAX_UPLOAD_BYTES=5368709120
PC_PORTAL_MODELS_DIR=./docker/portal/empty-models
PC_PORTAL_PORT=8088
PC_PORTAL_ALLOW_CLOUD=0
# Configure one authentication option using the standard Azure Identity names.
# Keep secrets in an untracked env file or your hosting service's secret settings.
# Compose forwards missing optional variables as empty strings.
# The portal handles empty defaults; leave unused variables unset outside Compose.
#
# Service principal with secret (EnvironmentCredential):
# AZURE_TENANT_ID=<directory-id>
# AZURE_CLIENT_ID=<application-client-id>
# AZURE_CLIENT_SECRET=<client-secret>
#
# Service principal with certificate (EnvironmentCredential):
# Do not set AZURE_CLIENT_SECRET for certificate authentication.
# AZURE_TENANT_ID=<directory-id>
# AZURE_CLIENT_ID=<application-client-id>
# AZURE_CLIENT_CERTIFICATE_PATH=/run/secrets/azure/client.pem
# Optional, only for encrypted PEM/PKCS12 certificates:
# AZURE_CLIENT_CERTIFICATE_PASSWORD=<certificate-password>
# Optional, enable only for Subject Name/Issuer authentication; otherwise leave unset:
# AZURE_CLIENT_SEND_CERTIFICATE_CHAIN=True
#
# Federated workload identity (WorkloadIdentityCredential):
# AZURE_TENANT_ID=<directory-id>
# AZURE_CLIENT_ID=<application-client-id>
# AZURE_FEDERATED_TOKEN_FILE=/run/secrets/azure/token
#
# Optional authority for these credentials; defaults to Azure Public Cloud:
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.com
#
# Without service-principal/workload settings, WEBSITE_HOSTNAME selects managed identity.
# Leave WEBSITE_HOSTNAME unset locally to use DefaultAzureCredential.
# Azure host with AZURE_CLIENT_ID: user-assigned identity; otherwise system-assigned.
# Certificate/token paths are CONTAINER paths. Mount the files read-only separately.
# Container path. Package metadata is persistent in portal-state.
PC_PORTAL_OUTPUT_ROOT=/var/lib/people-counter/portal/packages
