# Required: an existing ADLS Gen2 account and filesystem. No local footage mount.
PC_PORTAL_ADLS_ACCOUNT_URL=https://youraccount.dfs.core.windows.net
PC_PORTAL_ADLS_FILESYSTEM=videos
PC_PORTAL_ADLS_ROOT=
PC_PORTAL_MAX_UPLOAD_BYTES=5368709120
PC_PORTAL_MODELS_DIR=./docker/portal/empty-models
PC_PORTAL_PORT=8088
PC_PORTAL_ALLOW_CLOUD=0
# Configure standard DefaultAzureCredential variables outside source control.
# Container path. Package metadata is persistent in portal-state.
PC_PORTAL_OUTPUT_ROOT=/var/lib/people-counter/portal/packages
