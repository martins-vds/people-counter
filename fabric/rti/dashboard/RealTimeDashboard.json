  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "68f2b829-3e60-4fd3-8a1b-a9b07978cad0"
      },
      "text": "let CurrentJobs =\r\n    ItemJobEventLogs\r\n    | where Timestamp between (_startTime .. _endTime)\r\n    | where isempty(_itemName) or ItemName in (_itemName)\r\n    | where isempty(_jobType) or JobType in (_jobType)\r\n    | summarize arg_max(Timestamp, *) by JobInstanceId;\r\nCurrentJobs\r\n| where isempty(_jobStatus) or JobStatus in (_jobStatus)\r\n| summarize Jobs = count() by JobStatus\r\n| order by JobStatus asc",
      "id": "4009350e-18c6-4382-89e6-f90521908c13",
      "usedVariables": [
        "_endTime",
        "_itemName",
        "_jobStatus",
        "_jobType",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "68f2b829-3e60-4fd3-8a1b-a9b07978cad0"
      },
      "text": "ItemJobEventLogs\r\n| where Timestamp between (_startTime .. _endTime)\r\n| where isempty(_itemName) or ItemName in (_itemName)\r\n| where isempty(_jobType) or JobType in (_jobType)\r\n| summarize arg_max(Timestamp, *) by JobInstanceId\r\n| where JobStatus == \"InProgress\"\r\n| summarize RunningJobs = count()\r\n",
      "id": "65399e02-d054-4dac-b822-e6d5f6f3b6b5",
      "usedVariables": [
        "_endTime",
        "_itemName",
        "_jobType",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "68f2b829-3e60-4fd3-8a1b-a9b07978cad0"
      },
      "text": "ItemJobEventLogs\r\n| where Timestamp between (_startTime .. _endTime)\r\n| where isempty(_itemName) or ItemName in (_itemName)\r\n| where isempty(_jobType) or JobType in (_jobType)\r\n| summarize arg_max(Timestamp, *) by JobInstanceId\r\n| where JobStatus == \"NotStarted\"\r\n| summarize NotStartedJobs = count()\r\n",
      "id": "ae500a4c-7790-4a00-9832-b58085afd1e1",
      "usedVariables": [
        "_endTime",
        "_itemName",
        "_jobType",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "68f2b829-3e60-4fd3-8a1b-a9b07978cad0"
      },
      "text": "ItemJobEventLogs\r\n| where Timestamp between (_startTime .. _endTime)\r\n| where isempty(_itemName) or ItemName in (_itemName)\r\n| where isempty(_jobType) or JobType in (_jobType)\r\n| summarize arg_max(Timestamp, *) by JobInstanceId\r\n| where JobStatus == \"NotStarted\"\r\n| extend QueueReferenceTime = coalesce(JobScheduleTime, Timestamp)\r\n| summarize OldestQueueAgeMinutes =\r\n    max(datetime_diff(\"minute\", now(), QueueReferenceTime))\r\n",
      "id": "4db8b4ba-f4d8-418e-865f-af5c86f3d28b",
      "usedVariables": [
        "_endTime",
        "_itemName",
        "_jobType",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "68f2b829-3e60-4fd3-8a1b-a9b07978cad0"
      },
      "text": "ItemJobEventLogs\r\n| where Timestamp between (_startTime .. _endTime)\r\n| where isempty(_itemName) or ItemName in (_itemName)\r\n| where isempty(_jobType) or JobType in (_jobType)\r\n| summarize arg_max(Timestamp, *) by JobInstanceId\r\n| where JobStatus in (\"Completed\", \"Failed\", \"Cancelled\")\r\n| summarize P95DurationMinutes =\r\n    percentile(todouble(DurationMs), 95) / 60000.0\r\n",
      "id": "e84b5185-6602-4241-844b-5a6852058a22",
      "usedVariables": [
        "_endTime",
        "_itemName",
        "_jobType",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "68f2b829-3e60-4fd3-8a1b-a9b07978cad0"
      },
      "text": "ItemJobEventLogs\r\n| where Timestamp between (_startTime .. _endTime)\r\n| where isempty(_itemName) or ItemName in (_itemName)\r\n| where isempty(_jobType) or JobType in (_jobType)\r\n| summarize arg_max(Timestamp, *) by JobInstanceId\r\n| where JobStatus == \"Failed\"\r\n| project\r\n    Timestamp,\r\n    WorkspaceName,\r\n    ItemKind,\r\n    ItemName,\r\n    JobType,\r\n    JobInstanceId,\r\n    JobInvokeType,\r\n    DurationMinutes = todouble(DurationMs) / 60000.0,\r\n    CapacityId\r\n| top 50 by Timestamp desc\r\n",
      "id": "d406714a-6881-4fa1-93b5-173c9f16c093",
      "usedVariables": [
        "_endTime",
        "_itemName",
        "_jobType",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "68f2b829-3e60-4fd3-8a1b-a9b07978cad0"
      },
      "text": "ItemJobEventLogs\r\n| where Timestamp between (_startTime .. _endTime)\r\n| where isempty(_itemName) or ItemName in (_itemName)\r\n| where isempty(_jobType) or JobType in (_jobType)\r\n| where JobStatus in (\"Completed\", \"Failed\", \"Cancelled\")\r\n| summarize Jobs = dcount(JobInstanceId)\r\n    by Hour = bin(Timestamp, 1h), JobStatus\r\n| order by Hour asc\r\n",
      "id": "823ff8dd-2588-4fd1-a3db-27e21ab79930",
      "usedVariables": [
        "_endTime",
        "_itemName",
        "_jobType",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "68f2b829-3e60-4fd3-8a1b-a9b07978cad0"
      },
      "text": "ItemJobEventLogs\r\n| where ItemName in (\"pc-event-intake\", \"01_register_event\")\r\n| summarize arg_max(Timestamp, *) by JobInstanceId\r\n| where JobStatus in (\"NotStarted\", \"InProgress\")\r\n| extend ReferenceTime =\r\n    iff(\r\n        JobStatus == \"NotStarted\",\r\n        coalesce(JobScheduleTime, Timestamp),\r\n        coalesce(JobStartTime, Timestamp)\r\n    )\r\n| extend ElapsedMinutes =\r\n    datetime_diff(\"minute\", now(), ReferenceTime)\r\n| where ElapsedMinutes >= 20\r\n| extend AlertTimestamp = now()\r\n| project\r\n    AlertTimestamp,\r\n    JobInstanceId,\r\n    ItemName,\r\n    JobType,\r\n    JobStatus,\r\n    ElapsedMinutes,\r\n    JobScheduleTime,\r\n    JobStartTime,\r\n    WorkspaceName,\r\n    CapacityId\r\n| order by ElapsedMinutes desc\r\n",
      "id": "b86c01f4-cedb-4d9e-84c3-0456f783417c",
      "usedVariables": []
    },
