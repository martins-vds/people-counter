model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - {{ .TargetLakehouseName }}"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit"]

ref table people_counter_gold_operations_hour
ref table people_counter_gold_flow_minute
ref table people_counter_gold_video
ref table people_counter_gold_flow_hour
ref table people_counter_gold_dim_video
ref table people_counter_gold_dim_time
ref table people_counter_gold_dim_location
ref table people_counter_gold_dim_date
ref table people_counter_gold_dim_camera
ref table people_counter_gold_dim_model_config
ref table 'Forecast Workload'
ref table 'Forecast Capacity'

