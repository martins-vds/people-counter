table people_counter_gold_flow_minute
	lineageTag: 5c160998-fb8b-4185-8ba1-a618637e0868
	sourceLineageTag: [dbo].[people_counter_sjd_gold_flow_minute]

	measure 'Total Entries' =
			
			SUM(people_counter_gold_flow_minute[entries])
		formatString: 0
		displayFolder: Traffic KPIs
		lineageTag: 8e517d0b-365f-4eca-96b3-4818ff431c7d

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Total Exits' =
			
			SUM(people_counter_gold_flow_minute[exits])
		formatString: 0
		displayFolder: Traffic KPIs
		lineageTag: 3156fb2e-4a7d-4400-9697-417a5ce524a5

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Net Flow' =
			
			[Total Entries] - [Total Exits]
		formatString: 0
		displayFolder: Traffic KPIs
		lineageTag: 95420bdf-9b23-43a7-bcad-67bc182191a0

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Cumulative Net Flow' =
			
			VAR CurrentMinute =
			    MAX(people_counter_gold_flow_minute[minute_utc])
			RETURN
			    CALCULATE(
			        [Net Flow],
			        FILTER(
			            ALLSELECTED(
			                people_counter_gold_flow_minute[minute_utc]
			            ),
			            people_counter_gold_flow_minute[minute_utc]
			                <= CurrentMinute
			        )
			    )
		formatString: 0
		displayFolder: Traffic KPIs
		lineageTag: 459843a4-6b13-4ee9-a493-da1cd7f78a7b

		changedProperty = Name

		changedProperty = DisplayFolder

