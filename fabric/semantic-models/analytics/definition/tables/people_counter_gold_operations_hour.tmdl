table people_counter_gold_operations_hour
	lineageTag: 5b1d3597-1f3f-411e-bd07-9c21fe56bf3d
	sourceLineageTag: [dbo].[people_counter_sjd_gold_operations_hour]

	measure 'Queued Work' =
			
			SUM(people_counter_gold_operations_hour[queued])
		formatString: 0
		displayFolder: Operations KPIs
		lineageTag: 9c006d52-0efe-4568-85cb-3e70959284af

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Started Attempts' =
			
			SUM(people_counter_gold_operations_hour[started])
		formatString: 0
		displayFolder: Operations KPIs
		lineageTag: 4527abb6-c4c5-4414-9599-4b0661ed044f

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Succeeded Attempts' =
			
			SUM(people_counter_gold_operations_hour[succeeded])
		formatString: 0
		displayFolder: Operations KPIs
		lineageTag: 6c119979-41b6-43e8-bde9-a0ce09536491

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Failed Attempts' =
			
			SUM(people_counter_gold_operations_hour[failed])
		formatString: 0
		displayFolder: Operations KPIs
		lineageTag: 875e05a8-5030-44ce-a9f7-68573d444f6b

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Attempt Success Rate' =
			
			DIVIDE(
			    [Succeeded Attempts],
			    [Succeeded Attempts] + [Failed Attempts]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Operations KPIs
		lineageTag: cdb6a83a-8bac-4572-8f41-b14a58da392c

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Attempt Failure Rate' =
			
			DIVIDE(
			    [Failed Attempts],
			    [Succeeded Attempts] + [Failed Attempts]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Operations KPIs
		lineageTag: 853b5033-9700-4763-a1d7-c4bc3056a0d2

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Completed Video Hours' =
			
			SUM(
			    people_counter_gold_operations_hour[video_hours_completed]
			)
		formatString: 0.00
		displayFolder: Operations KPIs
		lineageTag: 94434353-3cc8-4b78-bbb5-cf75bb24461e

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Flow Data Freshness Minutes' =
			
			VAR LatestRefresh =
			    CALCULATE(
			        MAX(people_counter_gold_flow_minute[refreshed_at]),
			        REMOVEFILTERS()
			    )
			RETURN
			    IF(
			        ISBLANK(LatestRefresh),
			        BLANK(),
			        DATEDIFF(LatestRefresh, UTCNOW(), MINUTE)
			    )
		formatString: 0
		displayFolder: Quality KPIs
		lineageTag: 70c13b49-36e0-48ca-9d76-99a493dfb4e7

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Latest Video Completion Age Minutes' =
			
			VAR LatestCompletion =
			    CALCULATE(
			        MAX(people_counter_gold_video[completed_at]),
			        REMOVEFILTERS()
			    )
			RETURN
			    IF(
			        ISBLANK(LatestCompletion),
			        BLANK(),
			        DATEDIFF(LatestCompletion, UTCNOW(), MINUTE)
			    )
		formatString: 0
		displayFolder: Quality KPIs
		lineageTag: 577a44c8-1778-40d9-818d-ecc8111ea951

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Operations Data Freshness Minutes' =
			
			VAR LatestRefresh =
			    CALCULATE(
			        MAX(
			            people_counter_gold_operations_hour[refreshed_at]
			        ),
			        REMOVEFILTERS()
			    )
			RETURN
			    IF(
			        ISBLANK(LatestRefresh),
			        BLANK(),
			        DATEDIFF(LatestRefresh, UTCNOW(), MINUTE)
			    )
		formatString: 0
		displayFolder: Quality KPIs
		lineageTag: 54f1aa32-bd27-4e74-b41e-151aedcbe108

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Data Freshness Minutes' =
			
			MAX(
			    [Flow Data Freshness Minutes],
			    [Operations Data Freshness Minutes]
			)
		formatString: 0
		displayFolder: Quality KPIs
		lineageTag: 02607a64-2e53-4f6b-bcf3-9b8ced98f2e6

		changedProperty = Name

		changedProperty = DisplayFolder

