table people_counter_gold_video
	lineageTag: f675187e-585d-44b7-bb4b-4abc151beb28
	sourceLineageTag: [dbo].[people_counter_sjd_gold_video]

	measure 'Videos Processed' =
			
			DISTINCTCOUNT(people_counter_gold_video[work_id])
		formatString: 0
		displayFolder: Video KPIs
		lineageTag: d84097af-4c6f-436c-a0b8-c0d7a68dff83

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Video Hours Processed' =
			
			DIVIDE(
			    SUM(people_counter_gold_video[video_duration_seconds]),
			    3600.0
			)
		formatString: 0.00
		displayFolder: Video KPIs
		lineageTag: e30a5bf5-7a4a-4fc9-95a2-f66bc782381c

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Distinct Tracks per Video' =
			
			AVERAGE(people_counter_gold_video[distinct_people])
		formatString: 0.00
		displayFolder: Video KPIs
		lineageTag: c27a214e-a661-4979-a9af-392be095b063

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Processing Speed x Real Time' =
			
			DIVIDE(
			    SUM(people_counter_gold_video[video_duration_seconds]),
			    SUM(people_counter_gold_video[processing_seconds])
			)
		displayFolder: Video KPIs
		lineageTag: a7fdc14a-ee1b-4d6a-a6a4-b727f41a0ddf

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Videos Missing Required Metrics' =
			
			CALCULATE(
			    DISTINCTCOUNT(people_counter_gold_video[work_id]),
			    FILTER(
			        people_counter_gold_video,
			        ISBLANK(
			            people_counter_gold_video[video_duration_seconds]
			        )
			            || ISBLANK(
			                people_counter_gold_video[processing_seconds]
			            )
			            || ISBLANK(
			                people_counter_gold_video[distinct_people]
			            )
			    )
			)
		formatString: 0
		displayFolder: Video KPIs
		lineageTag: aaf70c89-2887-47be-ac51-e37e7d08caa3

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Missing Required Metrics Flag' =
			
			VAR MissingDuration =
			    ISBLANK(
			        MAX(
			            people_counter_gold_video[video_duration_seconds]
			        )
			    )
			VAR MissingProcessing =
			    ISBLANK(
			        MAX(people_counter_gold_video[processing_seconds])
			    )
			VAR MissingTracks =
			    ISBLANK(
			        MAX(people_counter_gold_video[distinct_people])
			    )
			RETURN
			    IF(
			        MissingDuration || MissingProcessing || MissingTracks,
			        1,
			        0
			    )
		formatString: 0
		displayFolder: Video KPIs
		lineageTag: d95b4887-cc7f-40e6-b401-bab7e1a432ae

		changedProperty = Name

		changedProperty = DisplayFolder

