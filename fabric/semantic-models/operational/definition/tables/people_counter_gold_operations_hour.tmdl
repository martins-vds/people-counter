table people_counter_gold_operations_hour
	lineageTag: fc61ccee-2ae9-4fea-86fe-3af12deec81f
	sourceLineageTag: [dbo].[people_counter_sjd_gold_operations_hour]

	measure 'Forecast Completion UTC' =
			
			VAR RatePerHour = [Average Video Hours Per Wall Hour]
			VAR RemainingHours = [Remaining Video Hours]
			RETURN
			    IF(
			        RatePerHour > 0,
			        UTCNOW() + DIVIDE(RemainingHours, RatePerHour * 24.0),
			        BLANK()
			    )
		formatString: General Date
		displayFolder: Backfill KPIs
		lineageTag: 7efec254-e5ed-4d60-a98f-789beea75f93

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Average Video Hours Per Wall Hour' =
			
			VAR StartedAt = [Backfill Start UTC]
			VAR ElapsedHours =
			    IF(
			        ISBLANK(StartedAt),
			        BLANK(),
			        MAX(1, DATEDIFF(StartedAt, UTCNOW(), HOUR))
			    )
			RETURN
			    DIVIDE([Backfill Completed Video Hours], ElapsedHours)
		displayFolder: Backfill KPIs
		lineageTag: 394ea369-f0a9-4224-86dd-041d526265cc

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Backfill Completed Video Hours' =
			
			CALCULATE(
			    [Completed Video Hours],
			    REMOVEFILTERS(people_counter_gold_operations_hour)
			)
		formatString: 0.00
		displayFolder: Backfill KPIs
		lineageTag: df2cdd8d-c9dc-444b-b2f5-2ce5a3bd3770

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Backfill Start UTC' =
			
			CALCULATE(
			    MIN(people_counter_gold_operations_hour[hour_utc]),
			    REMOVEFILTERS(people_counter_gold_operations_hour)
			)
		formatString: General Date
		displayFolder: Backfill KPIs
		lineageTag: 8a34b5de-4087-4b05-9bac-25db2bd216e4

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Backfill Target Video Hours' =
			
			200000.0
		displayFolder: Backfill KPIs
		lineageTag: e49f3a10-951e-49f9-ba8c-4e680ad3049c

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Remaining Video Hours' =
			
			MAX(
			    0.0,
			    [Backfill Target Video Hours]
			        - [Backfill Completed Video Hours]
			)
		formatString: 0.00
		displayFolder: Backfill KPIs
		lineageTag: 9caf6f76-a437-4be1-a012-fcaa63ca7255

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

