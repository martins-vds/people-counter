table people_counter_video_work
	lineageTag: 67f7257b-f9f6-459b-98ef-5752863fd04e
	sourceLineageTag: [dbo].[people_counter_sjd_gold_work_operations]

	measure 'Queue Depth' =
			
			CALCULATE(
			    COUNTROWS(people_counter_video_work),
			    people_counter_video_work[status] IN {"QUEUED", "RETRY_WAIT"}
			)
		formatString: 0
		displayFolder: Operations KPIs
		lineageTag: 49b4c940-131b-4f7d-9b5b-6ab7976c5fab

		changedProperty = Name

		changedProperty = IsHidden

		changedProperty = DisplayFolder

	measure 'Open Reconciliation Errors' =
			
			CALCULATE(
			    COUNTROWS(people_counter_reconciliation_findings),
			    people_counter_reconciliation_findings[severity] = "ERROR",
			    ISBLANK(people_counter_reconciliation_findings[resolved_at])
			)
		formatString: 0
		displayFolder: Operations KPIs
		lineageTag: 8e432aa2-5f64-4ead-b2c4-ecda3a09dafb

		changedProperty = Name

		changedProperty = IsHidden

		changedProperty = DisplayFolder

	measure 'Oldest Queue Age Minutes' =
			
			VAR OldestQueueEntry =
			    MINX(
			        FILTER(
			            people_counter_video_work,
			            people_counter_video_work[status]
			                IN {"QUEUED", "RETRY_WAIT"}
			        ),
			        people_counter_video_work[queue_entered_at]
			    )
			RETURN
			    IF(
			        ISBLANK(OldestQueueEntry),
			        BLANK(),
			        DATEDIFF(OldestQueueEntry, UTCNOW(), MINUTE)
			    )
		displayFolder: Operations KPIs
		lineageTag: f15dd3c4-83a8-4c12-8dc4-e5d910acd915

		changedProperty = Name

		changedProperty = IsHidden

		changedProperty = DisplayFolder

	measure 'Failed Work Count' =
			
			CALCULATE(
			    COUNTROWS(people_counter_video_work),
			    people_counter_video_work[status]
			        IN {"TERMINAL_FAILED", "DEAD_LETTERED"}
			)
		formatString: 0
		displayFolder: Operations KPIs
		lineageTag: ba5dfdf6-60c1-4ce7-b27a-f8cbc620aef7

		changedProperty = Name

		changedProperty = IsHidden

		changedProperty = DisplayFolder

	measure 'Dead Letter Count' =
			
			CALCULATE(
			    COUNTROWS(people_counter_video_work),
			    people_counter_video_work[status] = "DEAD_LETTERED"
			)
		formatString: 0
		displayFolder: Operations KPIs
		lineageTag: 9f3b6ffb-e165-4f92-b437-bbaa40cf83ce

		changedProperty = Name

		changedProperty = IsHidden

		changedProperty = DisplayFolder

	measure 'Completed Video Hours' =
			
			SUM(people_counter_gold_operations_hour[video_hours_completed])
		displayFolder: Operations KPIs
		lineageTag: f794898d-c5e6-4e94-8868-df05e30d1392

		changedProperty = Name

		changedProperty = IsHidden

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Active Leases' =
			
			CALCULATE(
			    COUNTROWS(people_counter_video_work),
			    people_counter_video_work[status]
			        IN {"LEASED", "STAGING", "RUNNING", "WRITING"}
			)
		formatString: 0
		displayFolder: Operations KPIs
		lineageTag: c076bb49-e6da-4b70-9dab-cad2fb92d397

		changedProperty = Name

		changedProperty = IsHidden

		changedProperty = DisplayFolder

