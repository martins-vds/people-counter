subscription_id     = "00000000-0000-0000-0000-000000000000"
tenant_id           = "11111111-1111-1111-1111-111111111111"
location            = "westeurope"
resource_group_name = "rg-people-counter-bootstrap"

state_storage_account_name     = "stpeoplecounterboot01"
state_storage_replication_type = "ZRS"
