  }
  test = {
    mode                 = "create"
    storage_account_name = "stpeoplecountertest01"
    container_name       = "people-counter"
  }
  prod = {
    mode                        = "existing"
    storage_account_resource_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-data/providers/Microsoft.Storage/storageAccounts/stpeoplecounterprod01"
