{
  "name": "people-counter-portal-checks",
  "private": true,
  "scripts": {
    "test:portal": "jest --coverage --runInBand && npm run crap:portal",
    "test:portal:mutation": "stryker run",
    "crap:portal": "crap evidence/portal-js/coverage/coverage-final.json --json evidence/portal-js/crap-report.json --html evidence/portal-js/crap-report && node scripts/check-portal-crap.cjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/jest-runner": "10.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.9",
    "crap-score": "1.2.1",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0"
  },
  "overrides": {
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "ajv@>=7": "8.20.0",
    "deepmerge": "npm:@shivammathur/deepmerge@4.3.2",
    "glob@>=9": "14.0.2",
    "minimatch@>=7 <11": "11.0.1",
    "picomatch@4": "4.0.4",
    "qs": "6.16.1",
    "tmp": "0.2.7",
    "webpack": "5.104.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": ["<rootDir>/tests/js", "<rootDir>/src/people_counter/portal_static"],
    "testMatch": ["<rootDir>/tests/js/**/*.test.cjs"],
    "collectCoverageFrom": ["src/people_counter/portal_static/**/*.js"],
    "coverageDirectory": "evidence/portal-js/coverage",
    "coverageReporters": ["json", "text", "html"]
  }
}
