# scripts/bootstrap-local.sh generates .env.deploy-dev.local automatically.
# Copy this file manually only when using an existing external bootstrap.
# This is a trusted Bash environment file. Do not add commands.

# Required by GitHub Actions OIDC; retained for parity with the documented
# environment contract. scripts/deploy-dev-local.sh uses Azure CLI instead.
AZURE_CLIENT_ID="<github-oidc-client-guid>"
AZURE_TENANT_ID="<tenant-guid>"
AZURE_SUBSCRIPTION_ID="<subscription-guid>"

TF_BACKEND_RESOURCE_GROUP_NAME="<terraform-state-resource-group>"
TF_BACKEND_STORAGE_ACCOUNT_NAME="<terraform-state-storage-account>"
TF_BACKEND_CONTAINER_NAME="<terraform-state-container>"

FABRIC_CAPACITY_ID="<fabric-capacity-guid>"
FABRIC_WORKSPACE_ROLE_ASSIGNMENTS='{}'

FABRIC_ADLS_STORAGE_ACCOUNT_RESOURCE_ID="/subscriptions/<subscription-guid>/resourceGroups/<resource-group>/providers/Microsoft.Storage/storageAccounts/<account>"
FABRIC_ADLS_SHORTCUT_CONTAINER="<container>"
FABRIC_ADLS_SHORTCUT_NAME="<shortcut-name>"
FABRIC_ADLS_SHORTCUT_PATH="Files/<parent-path>"
FABRIC_ADLS_SHORTCUT_TARGET_PATH=""

FABRIC_ENABLE_REPORTING="true"
FABRIC_ENABLE_RTI="true"
FABRIC_ENABLE_ACTIVATOR="true"
FABRIC_REQUIRE_ACTIVATOR_ACTION_CHECKPOINT="false"

# Optional. Keep empty when the Development action-execution checkpoint is deferred.
FABRIC_ACTIVATOR_ACTION_CHECKPOINT_JSON=""
